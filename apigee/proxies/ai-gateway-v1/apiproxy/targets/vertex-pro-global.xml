<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="vertex-pro-global">
    <Description>Southbound Vertex AI Gemini 2.5 Pro Target on Global Endpoint</Description>
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>AM-DisablePathSuffix</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows/>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPTargetConnection>
        <Authentication>
            <GoogleAccessToken>
                <Scopes>
                    <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
                </Scopes>
            </GoogleAccessToken>
        </Authentication>
        <Properties>
            <Property name="io.timeout.millis">90000</Property>
            <Property name="connect.timeout.millis">10000</Property>
        </Properties>
        <URL>https://aiplatform.googleapis.com/v1/projects/apac-cs-5g-demo5/locations/global/publishers/google/models/gemini-2.5-pro:generateContent</URL>
    </HTTPTargetConnection>
</TargetEndpoint>
