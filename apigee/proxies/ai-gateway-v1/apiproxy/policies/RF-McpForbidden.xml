<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RaiseFault async="false" continueOnError="false" enabled="true" name="RF-McpForbidden">
    <DisplayName>RF-McpForbidden</DisplayName>
    <FaultResponse>
        <Set>
            <Headers>
                <Header name="X-Apigee-MCP-Verdict">BLOCKED</Header>
                <Header name="X-Apigee-Fault-Name">{ai.mcp_fault_reason}</Header>
            </Headers>
            <Payload contentType="application/json">{
  "error": {
    "code": 403,
    "fault_name": "{ai.mcp_fault_reason}",
    "message": "{ai.mcp_block_detail}",
    "details": {
      "enforced_by": "Apigee X Native Proxy (ai-gateway-v1)",
      "human_principal_sub": "{ai.human_sub}",
      "acting_agent_spiffe": "{ai.spiffe_id}",
      "tool_name": "{ai.mcp_tool_name}",
      "user_allowed_tools": "{ai.mcp_user_tools}",
      "agent_allowed_tools": "{ai.mcp_agent_tools}",
      "effective_intersection_tools": "{ai.mcp_allowed_tools}"
    }
  }
}</Payload>
            <StatusCode>403</StatusCode>
            <ReasonPhrase>Forbidden</ReasonPhrase>
        </Set>
    </FaultResponse>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</RaiseFault>
