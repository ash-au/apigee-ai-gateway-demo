  "policy": "SG-EnforceEnterpriseDomain",
  "rule_id": "enterprise-domain-guardrail",
  "enforcement_mode": "ENFORCE",
  "verdict": "NON_COMPLIANT",
  "violation_domain": "{SemanticGovernance.SG-EnforceEnterpriseDomain.violation_domain}",
  "reason": "{ai.sg_violation_reason}"
